{
  "name": "ticketplus-assist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "icons": "node scripts/make-icons.mjs",
    "pack": "node scripts/pack.mjs",
    "demo:snapshot": "node demo/snapshot.mjs",
    "demo:build": "node demo/build.mjs",
    "demo:update": "node demo/snapshot.mjs && node demo/build.mjs",
    "demo": "node demo/serve.mjs",
    "news": "node scripts/fetch-news.mjs",
    "site:build": "node demo/build.mjs && node scripts/build-site.mjs",
    "site": "npm run news && npm run site:build"
  }
}
